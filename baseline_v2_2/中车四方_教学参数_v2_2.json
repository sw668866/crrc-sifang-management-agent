      "expect": "无证据支持，不能生成企业真实值"
    },
    {
      "id": "multi_optima",
      "test": "构造单位贡献为零的T1有效情景",
      "expect": "能提示并列最优，不随意称唯一最优"
    },
    {
      "id": "numeric_nan_price",
      "test": "价格NaN",
      "expect": "明确拒绝，不能误报无可行解"
    },
    {
      "id": "numeric_nan_hours",
      "test": "单件工时NaN",
      "expect": "明确拒绝，不输出非法小时的最优解"
    },
    {
      "id": "boolean_is_number",
      "test": "产能True、件数True",
      "expect": "拒绝布尔数值"
    },
    {
      "id": "unknown_extra_cost_field",
      "test": "情景中出现未知费用字段",
      "expect": "明确拒绝，不静默忽略"
    },
    {
      "id": "changed_variable_cost",
      "test": "修改T1单位相关变动成本",
      "expect": "使用新成本重新优化，T0不变"
    },
    {
      "id": "changed_demand",
      "test": "修改T1需求上限",
      "expect": "使用新需求重新优化，T0不变"
